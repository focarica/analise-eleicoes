# Token de leitura do banco compartilhado BDR-TSE, usado pelo servidor do painel.
MOTHERDUCK_TOKEN=cole_seu_token_aqui
R2_PUBLIC_BASE_URL=https://pub-5315a1ebee944662a6a18b8d03ef01e7.r2.dev
# Opcional: token com escrita em BDR-TSE para aplicar views e administrar dados.
MOTHERDUCK_TOKEN_READ_WRITE=cole_token_com_escrita_aqui
# Opcional: altere após atualizar dados em outro ambiente para invalidar o cache.
# CACHE_VERSION=identidades-brutas-v1
# Opcional: caminho do snapshot local da questão 7 (viés político).
# Padrão: frontend/.p7-vies.duckdb, gerado por `bun run p7-local`.
# P7_DB=
# Opcional: banco de origem do CSV municipal da P7 (`bun run p7-municipios`).
# Padrão: BDR-TSE-2026.
# P7_MOTHERDUCK_DB=
